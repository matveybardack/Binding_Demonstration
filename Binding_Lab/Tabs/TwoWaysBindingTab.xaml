<UserControl x:Class="Binding_Lab.Tabs.TwoWaysBindingTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Binding_Lab.Tabs"
             xmlns:vm="clr-namespace:Binding_Lab.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="600">
    <UniformGrid Margin="10" Rows="4" Columns="4">
        <!--Привязка textbox (TwoWay)-->
        <Label Content="{Binding Localization[TWlb1]}"/>
        <TextBox Text="{Binding TwoWayText, UpdateSourceTrigger=PropertyChanged}" Margin="5" VerticalAlignment="Top"/>
        <Label Content="{Binding Localization[TWllb1]}"/>
        <TextBox Text="{Binding TwoWayText, UpdateSourceTrigger=PropertyChanged}" Margin="5" VerticalAlignment="Top"/>

        <!-- Привязка CheckBox (TwoWay)-->
        <Label Content="{Binding Localization[TWlb2]}"/>
        <CheckBox IsChecked="{Binding TwoWayFlag}" 
          Content="{Binding Localization[TWchb1]}" 
          Margin="5" VerticalAlignment="Top"/>
        <Label Content="{Binding Localization[TWllb2]}"/>
        <CheckBox IsChecked="{Binding TwoWayFlag}" 
          Content="{Binding Localization[TWchb2]}" 
          Margin="5" VerticalAlignment="Top"/>

        <!-- Привязка Slider (TwoWay)-->
        <Label Content="{Binding Localization[TWlb3]}"/>
        <TextBox Text="{Binding TwoWayValue, UpdateSourceTrigger=PropertyChanged}" Margin="5" VerticalAlignment="Top"/>
        <Label Content="{Binding Localization[TWllb3]}"/>
        <Slider Value="{Binding TwoWayValue, UpdateSourceTrigger=PropertyChanged}" Height="20" Margin="5" VerticalAlignment="Top" Maximum="100"/>

    </UniformGrid>
</UserControl>
